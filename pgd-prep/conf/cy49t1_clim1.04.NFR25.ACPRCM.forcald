GRIDdep=EUC12

#=== Dates for surface and atmosphere restarts
NYEAR=2019
NMONTH=2
NDAY=15
ENDYEAR=2022
ENDMONTH=2

#=== Output directory: define SAVEDIR if wanted. Default : $workdir. Prefix, completed by each different job, e.g. : $SAVEDIR/pgd-prep/$expname
SAVEDIR=$workdir/arome/tests/${GRID}

#=== Namelists
NAMARPc927=/home/gmgec/mrgo/haradercoustaue/AROME49/NFR2.5/toolbox-arpege/namelist/atm/conf927_NFR3l60_cy49t1_clim1.04
