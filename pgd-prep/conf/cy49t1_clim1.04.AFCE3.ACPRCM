#=== New Domain options 
# See geometry name and levels below 
# Zonal and meridional resolution in meters  
DX=3000
# Longitude center of domain
LONCEN=24.375 
# Latitude center of domain
LATCEN=-6
# Number of pts C+I zonal  
NIMAX=1069
# Number of pts C+I meridian  
NJMAX=757
# Width of I zone  
NDZON=21
# Projection
PROJ=L 
# Specific epygram environment if desired
# please provide the activate file 
EPYV=/scratch/climat/APPS/venvs/epenv_py3.10/bin/activate


preNAMARPc927=/home/gmgec/mrgo/haradercoustaue/AROME49/ALPX3/namelist/atm/conf927_ALPX3l60_cy49t1_clim1.04
