#=== regional LBC options  
SRCDIR=/scratch/work/haradercoustaue/DATA/ERA5/clim
LBCDIR=hendrix:/home/haradercoustaue/DATA/ERA5/restart
GEOMM=tl399l137R
LELAM=.FALSE.

#=== Binaries
