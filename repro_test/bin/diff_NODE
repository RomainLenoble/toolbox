#!/usr/bin/env python3
"""diff_NODE -- compare two IFS/ARPEGE/AROME NODE.* forecast logs.

Reworked from the Perl `diffNODE` port for use both standalone ("do these
two runs agree?") and inside the repro_test suite (clean exit codes, small
stable reports, JSON).

What it compares
----------------
* SPECTRAL NORMS blocks -- the `LOG(PREHYDS)` scalar and the
  VORTICITY / DIVERGENCE / TEMPERATURE / KINETIC ENERGY norms (AVE row by
  default, per-level with --levels), each tied to its forecast step and
  predictor/corrector half (`NORMS AT NSTEP CNT4 (PREDICTOR) N`).
* GPNORM blocks (gridpoint norms) -- opt in with --gpnorms.
* Global observation Jo, when present.

Metric
------
For each matched value pair (ref v1, exp v2):

    abs_diff = |v2 - v1|
    rel_diff = |v2 - v1| / |v1|                (informational; inf near 0)
    flagged  = abs_diff > eff_atol + rtol*|v1|
    eff_atol = max(--atol, --atol-frac * peak|v1| over that field)

The per-field absolute floor (--atol-frac) is what stops near-zero fields
(divergence, vorticity averages, ...) from tripping on meaningless noise:
a difference smaller than a tiny fraction of the field's own peak is not a
finding. See METRIC_NOTES.md for the (open) question of a chaos-aware
metric.

Exit codes
----------
    0  all matched values within tolerance
    1  some values exceed tolerance, or the two files don't line up
    2  usage error / could not parse / nothing to compare

Usage
-----
    diff_NODE REF EXP [options]
    diff_NODE a/NODE.001_01 b/NODE.001_01 --full
    diff_NODE a b --gpnorms '*' --rtol 1e-3 --json
"""

from __future__ import annotations

import argparse
import json
import math
import re
import sys
from dataclasses import dataclass, field as dc_field

# --------------------------------------------------------------------------
# Presets
# --------------------------------------------------------------------------

PRESETS = {
    # AROME / ALADIN limited area: spectral norms present, gridpoint norms
    # are microphysics/diagnostic tracers -- compare spectral only by default.
    "arome-lam": {
        "spnorms": "VORTICITY,DIVERGENCE,TEMPERATURE,KINETIC ENERGY",
        "gpnorms": "",
    },
    # Global ARPEGE / IFS.
    "global": {
        "spnorms": "VORTICITY,DIVERGENCE,TEMPERATURE,KINETIC ENERGY,LOG(PREHYDS)",
        "gpnorms": "",
    },
}
DEFAULT_SPNORMS = "VORTICITY,DIVERGENCE,TEMPERATURE,KINETIC ENERGY"

# --------------------------------------------------------------------------
# Parsing
# --------------------------------------------------------------------------

RE_NSTEP = re.compile(r"NORMS AT NSTEP CNT4 \((PREDICTOR|CORRECTOR)\)\s+(\d+)")
RE_SP_HEADER = re.compile(r"^\s*SPECTRAL NORMS\s*-\s*(.+?)\s+(-?\d[0-9.eE+-]*)\s*$")
RE_LEV = re.compile(r"^\s*LEV\s+(.*\S)\s*$")
RE_AVE = re.compile(r"^\s*AVE\s+(.*\S)\s*$")
RE_LEVEL_ROW = re.compile(r"^\s*(\d+)\s+(-?\d[0-9.eE+\- ]*\S)\s*$")
RE_GP_HEADER = re.compile(r"^\s*GPNORM\s+(.+?)\s+AVERAGE\s+MINIMUM\s+MAXIMUM\s*$")

RE_OBSTYPE = re.compile(r"ObsType\s+(\d+)\s+Total:\s*(\d+)\s+(\S+)\s+")
RE_JOGLOBAL = re.compile(r"Jo Global\s*:\s*(\d+)\s+(\S+)")

HALF = {"PREDICTOR": "P", "CORRECTOR": "C"}


@dataclass
class Rec:
    kind: str            # "sp" | "gp"
    field: str           # "VORTICITY", "LOG(PREHYDS)", "HUMI.SPECIFI", ...
    nstep: int | None    # forecast step, or None for pre-forecast dumps
    half: str            # "P" | "C" | ""
    level: str           # "AVE" | "L01".. | "" (scalar)
    stat: str            # "avg" | "min" | "max"
    value: float

    def key(self) -> tuple:
        return (self.kind, self.field, self.nstep, self.half, self.level, self.stat)

    def where(self) -> str:
        step = "init" if self.nstep is None else f"n{self.nstep}{self.half}"
        loc = self.level or "-"
        stat = "" if self.stat == "avg" else f".{self.stat}"
        return f"{step}/{loc}{stat}"


def _floats(s: str) -> list[float]:
    out = []
    for tok in s.split():
        try:
            out.append(float(tok))
        except ValueError:
            pass
    return out


def parse_node(path: str, spnorms: set[str], gpnorms: object,
               want_levels: bool) -> list[Rec]:
    """gpnorms: set[str] of field names, or the string '*' for all, or an
    empty set for none."""
    try:
        with open(path, "r", errors="replace") as fh:
            lines = fh.readlines()
    except OSError as exc:
        sys.exit(f"diff_NODE: cannot read {path}: {exc}")

    recs: list[Rec] = []
    nstep: int | None = None
    half = ""
    i, n = 0, len(lines)

    while i < n:
        line = lines[i]

        m = RE_NSTEP.search(line)
        if m:
            half = HALF[m.group(1)]
            nstep = int(m.group(2))
            i += 1
            continue

        m = RE_SP_HEADER.match(line)
        if m:
            scalar_field = m.group(1).strip()
            try:
                scalar_val = float(m.group(2))
            except ValueError:
                scalar_val = None
            if scalar_val is not None and (not spnorms or scalar_field in spnorms
                                           or scalar_field == "LOG(PREHYDS)"):
                recs.append(Rec("sp", scalar_field, nstep, half, "", "avg", scalar_val))
            i += 1
            # optional  LEV <cols> / AVE <vals> / per-level rows
            if i < n:
                mlev = RE_LEV.match(lines[i])
                if mlev:
                    cols = re.split(r"\s{2,}", mlev.group(1).strip())
                    i += 1
                    mave = RE_AVE.match(lines[i]) if i < n else None
                    if mave:
                        vals = _floats(mave.group(1))
                        for c, v in zip(cols, vals):
                            if not spnorms or c in spnorms:
                                recs.append(Rec("sp", c, nstep, half, "AVE", "avg", v))
                        i += 1
                        while i < n:
                            mrow = RE_LEVEL_ROW.match(lines[i])
                            if not mrow:
                                break
                            if want_levels:
                                lev = f"L{int(mrow.group(1)):02d}"
                                vals = _floats(mrow.group(2))
                                for c, v in zip(cols, vals):
                                    if not spnorms or c in spnorms:
                                        recs.append(Rec("sp", c, nstep, half, lev, "avg", v))
                            i += 1
            continue

        m = RE_GP_HEADER.match(line)
        if m and gpnorms:
            fld = m.group(1).strip()
            take = (gpnorms == "*") or (fld in gpnorms)
            i += 1
            if take and i < n:
                mave = RE_AVE.match(lines[i])
                if mave:
                    vals = _floats(mave.group(1))
                    for st, v in zip(("avg", "min", "max"), vals):
                        recs.append(Rec("gp", fld, nstep, half, "AVE", st, v))
            continue

        i += 1

    return recs


def parse_obs(path: str) -> dict:
    obstype: dict[int, dict] = {}
    jog = None
    with open(path, "r", errors="replace") as fh:
        for line in fh:
            m = RE_OBSTYPE.search(line)
            if m:
                try:
                    obstype[int(m.group(1))] = {"n": int(m.group(2)), "jo": float(m.group(3))}
                except ValueError:
                    pass
            m = RE_JOGLOBAL.search(line)
            if m:
                try:
                    jog = {"n": int(m.group(1)), "jo": float(m.group(2))}
                except ValueError:
                    pass
    return {"obstype": obstype, "jog": jog}


# --------------------------------------------------------------------------
# Comparison
# --------------------------------------------------------------------------

@dataclass
class Pair:
    rec_ref: Rec
    v_exp: float
    abs_diff: float
    rel_diff: float          # |d| / |v1|  (inf if v1 == 0 and d != 0)
    flagged: bool


@dataclass
class FieldSummary:
    kind: str
    field: str
    n: int = 0
    n_flagged: int = 0
    max_abs: float = 0.0
    max_abs_at: str = ""
    max_rel: float = 0.0
    max_rel_at: str = ""

    @property
    def ok(self) -> bool:
        return self.n_flagged == 0


@dataclass
class Comparison:
    pairs: list[Pair] = dc_field(default_factory=list)
    ref_only: list[tuple] = dc_field(default_factory=list)
    exp_only: list[tuple] = dc_field(default_factory=list)
    fields: dict[tuple, FieldSummary] = dc_field(default_factory=dict)

    @property
    def n_flagged(self) -> int:
        return sum(1 for p in self.pairs if p.flagged)

    @property
    def structural_mismatch(self) -> bool:
        return bool(self.ref_only or self.exp_only)

    @property
    def ok(self) -> bool:
        return self.n_flagged == 0 and not self.structural_mismatch and bool(self.pairs)


def _index(recs: list[Rec]) -> dict[tuple, list[Rec]]:
    idx: dict[tuple, list[Rec]] = {}
    for r in recs:
        idx.setdefault(r.key(), []).append(r)
    return idx


def compare(recs_ref: list[Rec], recs_exp: list[Rec], *,
            rtol: float, atol: float, atol_frac: float,
            max_nstep: int | None) -> Comparison:
    if max_nstep is not None:
        recs_ref = [r for r in recs_ref if r.nstep is None or r.nstep <= max_nstep]
        recs_exp = [r for r in recs_exp if r.nstep is None or r.nstep <= max_nstep]

    # per-field magnitude scale from the reference, for the absolute floor
    scale: dict[tuple, float] = {}
    for r in recs_ref:
        fk = (r.kind, r.field)
        scale[fk] = max(scale.get(fk, 0.0), abs(r.value))

    idx_ref = _index(recs_ref)
    idx_exp = _index(recs_exp)
    cmp = Comparison()

    for key in idx_ref.keys() | idx_exp.keys():
        lr = idx_ref.get(key, [])
        le = idx_exp.get(key, [])
        m = min(len(lr), len(le))
        for j in range(m):
            r = lr[j]
            v1, v2 = r.value, le[j].value
            d = abs(v2 - v1)
            eff_atol = max(atol, atol_frac * scale.get((r.kind, r.field), 0.0))
            flagged = d > eff_atol + rtol * abs(v1)
            rel = d / abs(v1) if v1 != 0 else (0.0 if d == 0 else math.inf)
            cmp.pairs.append(Pair(r, v2, d, rel, flagged))

            fk = (r.kind, r.field)
            fs = cmp.fields.get(fk)
            if fs is None:
                fs = cmp.fields[fk] = FieldSummary(r.kind, r.field)
            fs.n += 1
            if flagged:
                fs.n_flagged += 1
            if d > fs.max_abs:
                fs.max_abs, fs.max_abs_at = d, r.where()
            if rel > fs.max_rel:
                fs.max_rel, fs.max_rel_at = rel, r.where()

        for j in range(m, len(lr)):
            cmp.ref_only.append((key, lr[j].where()))
        for j in range(m, len(le)):
            cmp.exp_only.append((key, le[j].where()))

    return cmp


# --------------------------------------------------------------------------
# Reporting
# --------------------------------------------------------------------------

def fmt_rel(x: float) -> str:
    if x == math.inf:
        return "     inf"
    return f"{x:8.1e}"


def print_field_table(cmp: Comparison, out) -> None:
    order = sorted(cmp.fields.values(), key=lambda f: (f.kind, f.field))
    out.write(f"{'FIELD':<22} {'KIND':<4} {'N':>5} {'FLAG':>5} "
              f"{'MAX|Δ|':>12} {'@':<12} {'MAXrel':>9} {'@':<12}\n")
    for f in order:
        out.write(f"{f.field:<22} {f.kind:<4} {f.n:>5} {f.n_flagged:>5} "
                  f"{f.max_abs:12.4e} {f.max_abs_at:<12} "
                  f"{fmt_rel(f.max_rel):>9} {f.max_rel_at:<12}"
                  f"{'  <-- FAIL' if not f.ok else ''}\n")


def print_by_step(cmp: Comparison, out) -> None:
    rows: dict[tuple, FieldSummary] = {}
    for p in cmp.pairs:
        r = p.rec_ref
        k = (r.kind, r.field, r.nstep, r.half)
        fs = rows.get(k)
        if fs is None:
            fs = rows[k] = FieldSummary(r.kind, f"{r.field}")
        fs.n += 1
        if p.flagged:
            fs.n_flagged += 1
        if p.abs_diff > fs.max_abs:
            fs.max_abs = p.abs_diff
        if p.rel_diff > fs.max_rel:
            fs.max_rel = p.rel_diff
    out.write(f"{'FIELD':<20} {'STEP':>7} {'N':>4} {'FLAG':>4} {'MAX|Δ|':>12} {'MAXrel':>9}\n")
    for (kind, fld, nstep, half), fs in sorted(
            rows.items(), key=lambda kv: (kv[0][0], kv[0][1], kv[0][2] or -1, kv[0][3])):
        step = "init" if nstep is None else f"{nstep}{half}"
        out.write(f"{fld:<20} {step:>7} {fs.n:>4} {fs.n_flagged:>4} "
                  f"{fs.max_abs:12.4e} {fmt_rel(fs.max_rel):>9}"
                  f"{'  <-- FAIL' if fs.n_flagged else ''}\n")


def print_full(cmp: Comparison, out, only_flagged: bool) -> None:
    out.write(f"{'FIELD':<20} {'WHERE':<16} {'REF':>18} {'EXP':>18} "
              f"{'|Δ|':>12} {'rel':>9}\n")
    for p in cmp.pairs:
        if only_flagged and not p.flagged:
            continue
        r = p.rec_ref
        out.write(f"{r.field:<20} {r.where():<16} {r.value:18.9e} {p.v_exp:18.9e} "
                  f"{p.abs_diff:12.4e} {fmt_rel(p.rel_diff):>9}"
                  f"{'  *' if p.flagged else ''}\n")


def obs_verdict(obs_ref: dict, obs_exp: dict, jo_rtol: float):
    jr, je = obs_ref["jog"], obs_exp["jog"]
    if not jr or not je:
        return None
    denom = abs(jr["jo"]) or 1.0
    rel = abs(je["jo"] - jr["jo"]) / denom
    return {"ref": jr, "exp": je, "rel": rel, "flagged": rel > jo_rtol}


# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="diff_NODE",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=__doc__)
    p.add_argument("ref", help="reference NODE file")
    p.add_argument("exp", help="experiment NODE file")

    g = p.add_argument_group("selection")
    g.add_argument("--preset", choices=sorted(PRESETS), help="field-set preset")
    g.add_argument("--spnorms", default=None,
                   help=f"spectral norm fields (default: {DEFAULT_SPNORMS}); "
                        f"empty string = all spectral fields found")
    g.add_argument("--gpnorms", default="",
                   help="gridpoint norm fields to also compare; '*' = all, "
                        "'' = none (default)")
    g.add_argument("--levels", action="store_true",
                   help="also compare per-level spectral norms (default: AVE row only)")
    g.add_argument("--max-nstep", type=int, default=None,
                   help="only compare forecast steps with nstep <= N")
    g.add_argument("--fields-from", metavar="FILE",
                   help="file with extra field names, one per line; "
                        "'sp:NAME' / 'gp:NAME' prefixes accepted (default sp:)")

    g = p.add_argument_group("tolerance")
    g.add_argument("--rtol", type=float, default=1e-6, help="relative tolerance (default 1e-6)")
    g.add_argument("--atol", type=float, default=0.0, help="absolute tolerance floor (default 0)")
    g.add_argument("--atol-frac", type=float, default=1e-9,
                   help="per-field absolute floor as a fraction of that field's "
                        "peak |ref| value (default 1e-9)")
    g.add_argument("--jo-rtol", type=float, default=0.03,
                   help="relative tolerance for global observation Jo (default 0.03)")

    g = p.add_argument_group("output")
    g.add_argument("--full", "-v", action="store_true",
                   help="one row per compared value")
    g.add_argument("--flagged-only", action="store_true",
                   help="with --full, print only rows that exceed tolerance")
    g.add_argument("--by-step", action="store_true", help="one row per (field, step)")
    g.add_argument("--json", action="store_true", help="machine-readable summary on stdout")
    g.add_argument("--quiet", "-q", action="store_true", help="only the verdict line")
    return p


def resolve_fields(args):
    if args.preset:
        pre = PRESETS[args.preset]
        sp_raw = pre["spnorms"] if args.spnorms is None else args.spnorms
        gp_raw = args.gpnorms or pre["gpnorms"]
    else:
        sp_raw = DEFAULT_SPNORMS if args.spnorms is None else args.spnorms
        gp_raw = args.gpnorms

    spnorms = {s.strip() for s in sp_raw.split(",") if s.strip()}
    if gp_raw.strip() == "*":
        gpnorms: object = "*"
    else:
        gpnorms = {s.strip() for s in gp_raw.split(",") if s.strip()}

    if args.fields_from:
        with open(args.fields_from) as fh:
            for raw in fh:
                s = raw.split("#", 1)[0].strip()
                if not s:
                    continue
                if s.startswith("gp:"):
                    if gpnorms != "*":
                        gpnorms.add(s[3:].strip())
                else:
                    spnorms.add(s.removeprefix("sp:").strip())
    return spnorms, gpnorms


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    spnorms, gpnorms = resolve_fields(args)

    recs_ref = parse_node(args.ref, spnorms, gpnorms, args.levels)
    recs_exp = parse_node(args.exp, spnorms, gpnorms, args.levels)

    if not recs_ref and not recs_exp:
        print("diff_NODE: no SPECTRAL NORMS / GPNORM blocks found in either file "
              "(check --spnorms/--gpnorms).", file=sys.stderr)
        return 2

    cmp = compare(recs_ref, recs_exp, rtol=args.rtol, atol=args.atol,
                  atol_frac=args.atol_frac, max_nstep=args.max_nstep)

    obs_ref = parse_obs(args.ref)
    obs_exp = parse_obs(args.exp)
    ov = obs_verdict(obs_ref, obs_exp, args.jo_rtol)

    ok = cmp.ok and not (ov and ov["flagged"])
    max_abs = max((p.abs_diff for p in cmp.pairs), default=0.0)
    max_rel = max((p.rel_diff for p in cmp.pairs if p.rel_diff != math.inf), default=0.0)

    if args.json:
        payload = {
            "status": "pass" if ok else "fail",
            "ref": args.ref, "exp": args.exp,
            "rtol": args.rtol, "atol": args.atol, "atol_frac": args.atol_frac,
            "n_compared": len(cmp.pairs),
            "n_flagged": cmp.n_flagged,
            "max_abs_diff": max_abs,
            "max_rel_diff": max_rel,
            "structural_mismatch": cmp.structural_mismatch,
            "ref_only": len(cmp.ref_only),
            "exp_only": len(cmp.exp_only),
            "fields": [
                {"field": f.field, "kind": f.kind, "n": f.n, "n_flagged": f.n_flagged,
                 "max_abs_diff": f.max_abs, "max_rel_diff": (None if f.max_rel == math.inf else f.max_rel)}
                for f in sorted(cmp.fields.values(), key=lambda f: (f.kind, f.field))
            ],
            "obs_jo": (None if not ov else
                       {"ref": ov["ref"]["jo"], "exp": ov["exp"]["jo"],
                        "rel": ov["rel"], "flagged": ov["flagged"]}),
        }
        print(json.dumps(payload, indent=2))
        return 0 if ok else 1

    if not args.quiet:
        if args.full:
            print_full(cmp, sys.stdout, args.flagged_only)
        elif args.by_step:
            print_by_step(cmp, sys.stdout)
        else:
            print_field_table(cmp, sys.stdout)
        print()

        if cmp.structural_mismatch:
            print(f"STRUCTURAL MISMATCH: {len(cmp.ref_only)} value(s) only in ref, "
                  f"{len(cmp.exp_only)} only in exp "
                  f"(runs produced different norm blocks -- crashed / diverged early?)")
            for key, where in (cmp.ref_only[:5] + cmp.exp_only[:5]):
                print(f"    {key[1]:<22} {where}")
            print()

        if ov:
            tag = "  *" if ov["flagged"] else ""
            print(f"Global Jo: ref={ov['ref']['jo']:.6e} exp={ov['exp']['jo']:.6e} "
                  f"rel={ov['rel']:.2e}{tag}")
            print()

    verdict = "PASS" if ok else "FAIL"
    print(f"{verdict}: {len(cmp.pairs)} values compared, {cmp.n_flagged} flagged, "
          f"max|Δ|={max_abs:.2e}, max rel={max_rel:.2e} "
          f"(rtol={args.rtol:g}, atol_frac={args.atol_frac:g})")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
