#!/usr/bin/env python3
"""diff_fa_grib -- compare two FA or GRIB files field-by-field (via epygram).

Opens both files with epygram, iterates over every field present in the
reference, and for each one reports -- exactly like diff_netcdf does for
netCDF variables -- the max absolute difference, the RMS absolute
difference, and the RMS difference relative to the reference field's own
RMS. Spectral fields are transformed to gridpoint space before comparing.

Exits 1 (and prints a WARNING line, greppable like diff_NODE / diff_netcdf)
if any field's relative RMS diff exceeds --rel-max-diff; exits 2 if nothing
could be compared at all; exits 0 otherwise.

--plot-dir DIR writes, for each field that differs (or every field, with
--plot-when all), a PNG of the exp-ref difference map -- one map by default
(--plot-layout diff), or a ref | exp | exp-ref triptych with
--plot-layout panels. Needs matplotlib; nicer maps if cartopy is present.

Usage:
    diff_fa_grib ref.fa exp.fa [--fields SURFTEMPERATURE,S001WIND.U.PHYS]
    diff_fa_grib ref.grib exp.grib [--rel-max-diff 1e-4]
    diff_fa_grib a b --plot-dir maps/            # difference maps of flagged fields
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

import numpy as np
import epygram


def fid_key(fid) -> str:
    """A stable, printable one-line label for a field id (str for FA, dict
    for GRIB)."""
    if isinstance(fid, dict):
        # keep it compact and deterministic
        parts = [f"{k}={fid[k]}" for k in sorted(fid) if k not in ("generatingProcessIdentifier",)]
        return ",".join(parts)
    return str(fid)


def as_gridpoint_array(field) -> np.ndarray:
    """Return the field's values as a float64 ndarray with NaN-filled mask,
    converting from spectral space if needed."""
    if getattr(field, "spectral", False):
        field.sp2gp()
    data = field.getdata(d4=False)
    return np.ma.filled(np.ma.asarray(data).astype("float64"), np.nan)


# --------------------------------------------------------------------------
# Difference maps
# --------------------------------------------------------------------------

def _safe(name: str) -> str:
    return (re.sub(r"[^A-Za-z0-9._+-]", "_", name).strip("_") or "field")[:120]


def _robust_limit(a: np.ndarray) -> float:
    """Symmetric colour limit for a difference field: the 99.5th percentile
    of |Δ|, so a few spike cells don't wash the pattern out."""
    a = np.abs(a[np.isfinite(a)])
    if a.size == 0:
        return 1.0
    lim = float(np.nanpercentile(a, 90))
    return lim if lim > 0 else (float(a.max()) or 1.0)


def plot_field_diff(fref, r: np.ndarray, e: np.ndarray, label: str,
                    stats: tuple[float, float, float], path: Path, layout: str) -> bool:
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except Exception as exc:  # noqa: BLE001
        print(f" FGDIFF | matplotlib unavailable -- no maps ({exc})", file=sys.stderr)
        return False

    diff = e - r
    if diff.ndim != 2:                       # 3-D field: map the worst level
        k = int(np.nanargmax(np.nanmax(np.abs(diff).reshape(diff.shape[0], -1), axis=1)))
        r, e, diff = r[k], e[k], diff[k]
        label = f"{label} [lev {k}]"
    lim = _robust_limit(diff)
    abs_max, rms_abs, rel_rms = stats
    title = (f"{label}\nexp - ref   max|Δ|={abs_max:.3e}  RMS={rms_abs:.3e}  "
             f"relRMS={rel_rms:.2e}   (colour clip ±{lim:.2e})")
    path.parent.mkdir(parents=True, exist_ok=True)

    if layout == "panels":
        vlo, vhi = np.nanmin(r), np.nanmax(r)
        fig, axs = plt.subplots(1, 3, figsize=(15.0, 4.8))
        for ax, data, ttl, cmap, lims in (
                (axs[0], r, "reference", "viridis", (vlo, vhi)),
                (axs[1], e, "experiment", "viridis", (vlo, vhi)),
                (axs[2], diff, "exp - ref", "RdBu_r", (-lim, lim))):
            im = ax.imshow(data, origin="upper", interpolation="nearest",
                           aspect="auto", cmap=cmap, vmin=lims[0], vmax=lims[1])
            ax.set_title(ttl)
            fig.colorbar(im, ax=ax, shrink=0.85)
        fig.suptitle(title, fontsize=9)
        fig.tight_layout()
        fig.savefig(path, dpi=110)
        plt.close(fig)
        return True

    # layout == "diff": one map, via cartopy if we can, plain imshow otherwise
    try:
        fd = fref.deepcopy()
        fd.setdata(np.ma.masked_invalid(diff))
        out = fd.cartoplot(colormap="RdBu_r", center_cmap_on_0=True,
                           minmax=(-lim, lim), title=title, figsize=(11.0, 8.0))
        fig = out[0] if isinstance(out, tuple) else out
        try:
            import cartopy.crs as ccrs
            ax = out[1] if isinstance(out, tuple) and len(out) > 1 else fig.axes[0]
            lons, lats = fref.geometry.get_lonlat_grid()
            ij = np.unravel_index(np.nanargmax(np.abs(diff)), diff.shape)
            ax.plot(float(np.asarray(lons)[ij]), float(np.asarray(lats)[ij]),
                    "kx", ms=11, mew=2, transform=ccrs.PlateCarree())
        except Exception:  # noqa: BLE001
            pass
        fig.savefig(path, dpi=110)
        plt.close(fig)
        return True
    except Exception:  # noqa: BLE001 -- cartoplot is finicky; fall back
        fig, ax = plt.subplots(figsize=(9.0, 7.0))
        im = ax.imshow(diff, origin="upper", interpolation="nearest", aspect="auto",
                       cmap="RdBu_r", vmin=-lim, vmax=lim)
        try:
            ij = np.unravel_index(np.nanargmax(np.abs(diff)), diff.shape)
            ax.plot(ij[1], ij[0], "kx", ms=11, mew=2)
        except Exception:  # noqa: BLE001
            pass
        fig.colorbar(im, ax=ax)
        ax.set_title(title, fontsize=9)
        fig.tight_layout()
        fig.savefig(path, dpi=110)
        plt.close(fig)
        return True


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="diff_fa_grib",
        description="Compare two FA/GRIB files field-by-field (max/RMS abs+relative diffs).")
    parser.add_argument("ref", help="reference FA/GRIB file")
    parser.add_argument("exp", help="experiment FA/GRIB file")
    parser.add_argument("--fields", default="",
                        help="comma-separated field names/ids to restrict to "
                             "(default: every field in the reference)")
    parser.add_argument("--rel-max-diff", type=float, default=1e-4,
                        help="relative-RMS-diff threshold (default 1e-4)")
    parser.add_argument("--plot-dir", metavar="DIR",
                        help="write a difference-map PNG per field into DIR")
    parser.add_argument("--plot-when", choices=("flagged", "all"), default="flagged",
                        help="which fields to map (default: only those over threshold)")
    parser.add_argument("--plot-layout", choices=("diff", "panels"), default="diff",
                        help="'diff' = one exp-ref map (default); "
                             "'panels' = ref | exp | exp-ref")
    parser.add_argument("--plot-max", type=int, default=50,
                        help="stop after this many maps (default 50)")
    args = parser.parse_args(argv)

    only = [v for v in args.fields.split(",") if v] or None
    plot_dir = Path(args.plot_dir) if args.plot_dir else None
    n_plotted = 0

    try:
        epygram.init_env()
    except Exception:  # noqa: BLE001 -- best effort; some builds don't need it
        pass

    try:
        rref = epygram.formats.resource(args.ref, "r")
        rexp = epygram.formats.resource(args.exp, "r")
    except Exception as exc:  # noqa: BLE001
        print(f"diff_fa_grib: cannot open input(s): {exc}", file=sys.stderr)
        return 2

    any_warn = False
    any_compared = False

    try:
        ref_fids = rref.listfields()
    except Exception as exc:  # noqa: BLE001
        print(f"diff_fa_grib: cannot list fields of {args.ref}: {exc}", file=sys.stderr)
        return 2

    if only:
        ref_fids = [f for f in ref_fids if fid_key(f) in only or str(f) in only]

    print(f" FGDIFF | {'FIELD':32s} | {'MAX ABS DIFF':>14s} | {'RMS ABS DIFF':>14s} | {'REL RMS DIFF':>14s}")

    for fid in ref_fids:
        label = fid_key(fid)
        try:
            fref = rref.readfield(fid)
        except Exception as exc:  # noqa: BLE001
            print(f" FGDIFF | {label:32s} | SKIP -- unreadable in ref ({exc})")
            continue
        try:
            fexp = rexp.readfield(fid)
        except Exception as exc:  # noqa: BLE001
            print(f" FGDIFF | {label:32s} | SKIP -- not present/readable in exp ({exc})")
            continue

        # a resource can hand back a list when a fid is ambiguous (GRIB)
        if isinstance(fref, (list, tuple)) or isinstance(fexp, (list, tuple)):
            print(f" FGDIFF | {label:32s} | SKIP -- ambiguous field id (matches several messages)")
            continue

        try:
            r = as_gridpoint_array(fref)
            e = as_gridpoint_array(fexp)
        except Exception as exc:  # noqa: BLE001
            print(f" FGDIFF | {label:32s} | SKIP -- cannot extract data ({exc})")
            continue

        if r.shape != e.shape:
            print(f" FGDIFF | {label:32s} | SKIP -- shape mismatch {r.shape} vs {e.shape}")
            continue

        mask = np.isfinite(r) & np.isfinite(e)
        if not mask.any():
            print(f" FGDIFF | {label:32s} | SKIP -- no finite values in common")
            continue

        diff = e[mask] - r[mask]
        abs_max = float(np.max(np.abs(diff)))
        rms_abs = float(np.sqrt(np.mean(diff ** 2)))
        ref_rms = float(np.sqrt(np.mean(r[mask] ** 2)))
        if ref_rms != 0:
            rel_rms = rms_abs / ref_rms
        else:
            rel_rms = 0.0 if rms_abs == 0 else float("inf")

        flagged = rel_rms > args.rel_max_diff
        any_warn = any_warn or flagged
        any_compared = True
        flag = " *" if flagged else ""

        print(f" FGDIFF | {label:32s} | {abs_max:14.6e} | {rms_abs:14.6e} | {rel_rms:14.6e}{flag}")

        if (plot_dir is not None and n_plotted < args.plot_max
                and (args.plot_when == "all" or flagged) and abs_max > 0.0):
            png = plot_dir / f"{_safe(label)}.png"
            if plot_field_diff(fref, r, e, label, (abs_max, rms_abs, rel_rms),
                               png, args.plot_layout):
                n_plotted += 1

    if n_plotted:
        print()
        print(f"diff_fa_grib: wrote {n_plotted} difference map(s) to {plot_dir}")

    if any_warn:
        print()
        print(f"WARNING : SOME FA/GRIB FIELD DIFFERENCES ARE OUTSIDE ALLOWED LIMIT OF {args.rel_max_diff:.2e}")

    if not any_compared:
        print("Nothing was actually compared (no common fields / all skipped).", file=sys.stderr)
        return 2
    return 1 if any_warn else 0


if __name__ == "__main__":
    sys.exit(main())
